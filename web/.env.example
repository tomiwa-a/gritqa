# Copy to .env.local and fill in. Next loads .env.local automatically; the
# drizzle-kit config reads it too (see drizzle.config.ts).

# Postgres. Locally this is the brew postgresql@16 instance.
DATABASE_URL=postgresql://localhost:5432/gritqa

# Signs the session cookie and CLI bearer tokens. Any long random string:
#   openssl rand -base64 48
# Rotating it invalidates every session and every CLI credential.
SESSION_SECRET=

# Encrypts users.ai_api_key at rest (AES-256-GCM). Must be 32 bytes, base64:
#   openssl rand -base64 32
# Rotating it makes stored keys unreadable, so users re-enter them.
AI_KEY_SECRET=

# OAuth apps. Callback URL to register with each provider:
#   http://localhost:3000/api/auth/github/callback
#   http://localhost:3000/api/auth/gitlab/callback
# Scopes requested are read-only identity: GitHub `read:user user:email`,
# GitLab `read_user`. Neither grants repository access.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# Where OAuth redirects come back to. Set to the deployed origin in production.
APP_ORIGIN=http://localhost:3000

# Dev-only escape hatch: signs in as the seeded local user without an OAuth app,
# so the dashboard is reachable before the providers are registered. Ignored
# unless NODE_ENV is development. Never set this in production.
GRITQA_DEV_LOGIN=1

# ---------------------------------------------------------------------------
# The agent
# ---------------------------------------------------------------------------

# The CLI's MCP server, which is how the agent reads the codebase. Start it with
# `gritqa serve --serve 127.0.0.1:0` and copy the URL and the *read* bearer it
# prints. The CLI mints these per process and never writes them to disk, so both
# change every time it restarts -- and `next dev` has to be restarted to pick the
# new ones up. Drafting fails closed with CLI_UNAVAILABLE when they are unset or
# stale, which the dashboard renders as a state rather than an error.
#
# The read one specifically. MCP has no per-tool authorization, so scope decides
# which tools the CLI *advertises* -- a read bearer means a drafting agent never
# learns run_plan exists, rather than being refused it. Approved runs go out
# through `jobs` and do not touch this channel at all.
GRITQA_MCP_URL=
GRITQA_MCP_TOKEN=

# The model the developer's own key is spent against. Any OpenAI-compatible
# endpoint, which is what the AI settings page promises. The key itself is not
# here -- it lives encrypted in users.ai_api_key, entered through the dashboard.
GRITQA_MODEL=
GRITQA_MODEL_BASE_URL=

# Dev-only: draft without a stored key, billed to this server rather than the
# developer. Ignored when NODE_ENV is production, without exception.
#
# There are two ways in, gated differently on purpose.
#
# 1. A service account -- the trio below. Set it and drafting is on: a credential
#    written into this project's env file is already an explicit decision, so it
#    needs no second switch. google-auth-library mints and refreshes access tokens
#    from it, so nothing here expires and nothing has to be re-pasted. This is the
#    one to use; it is the difference between configuring Vertex once and doing it
#    again every morning.
#
#    Get it from IAM -> Service Accounts -> Keys -> Add key (JSON), then copy three
#    fields out of the download. The private key is multi-line and this file is not,
#    so paste it in double quotes with its newlines as \n -- GritQA normalises both
#    forms, but an unquoted paste is what produces `DECODER routines::unsupported`,
#    an error that says nothing about the actual problem.
#
#    Roles needed: Vertex AI User. Nothing else.
#
# 2. ADC -- `gcloud auth application-default login`, then GRITQA_DEV_MODEL=1. This
#    one needs the flag because ADC is ambient state on the machine, left behind by
#    a login for something else entirely, and should not start spending because it
#    happens to be there.
#
# Vertex rather than AI Studio either way: the free Generative Language tier is 20
# requests a day, which one afternoon of drafting exhausts before lunch.
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=
GCP_PROJECT_ID=

GRITQA_DEV_MODEL=
# Kept as a fallback for GCP_PROJECT_ID, so older setups keep working.
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1
