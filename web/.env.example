# Copy to .env.local and fill in. Next loads .env.local automatically; the
# drizzle-kit config reads it too (see drizzle.config.ts).

# Postgres. Locally this is the brew postgresql@16 instance.
DATABASE_URL=postgresql://localhost:5432/gritqa

# Signs the session cookie and CLI bearer tokens. Any long random string:
#   openssl rand -base64 48
# Rotating it invalidates every session and every CLI credential.
SESSION_SECRET=

# Encrypts users.ai_api_key at rest (AES-256-GCM). Must be 32 bytes, base64:
#   openssl rand -base64 32
# Rotating it makes stored keys unreadable, so users re-enter them.
AI_KEY_SECRET=

# OAuth apps. Callback URL to register with each provider:
#   http://localhost:3000/api/auth/github/callback
#   http://localhost:3000/api/auth/gitlab/callback
# Scopes requested are read-only identity: GitHub `read:user user:email`,
# GitLab `read_user`. Neither grants repository access.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# Where OAuth redirects come back to. Set to the deployed origin in production.
APP_ORIGIN=http://localhost:3000

# Dev-only escape hatch: signs in as the seeded local user without an OAuth app,
# so the dashboard is reachable before the providers are registered. Ignored
# unless NODE_ENV is development. Never set this in production.
GRITQA_DEV_LOGIN=1

# ---------------------------------------------------------------------------
# The agent
# ---------------------------------------------------------------------------

# The CLI's MCP server, which is how the agent reads the codebase. Start it with
# `gritqa serve --serve 127.0.0.1:0` and copy the URL and the *read* bearer it
# prints. The CLI mints these per process and never writes them to disk, so both
# change every time it restarts -- and `next dev` has to be restarted to pick the
# new ones up. Drafting fails closed with CLI_UNAVAILABLE when they are unset or
# stale, which the dashboard renders as a state rather than an error.
GRITQA_MCP_URL=
GRITQA_MCP_TOKEN=

# The model the developer's own key is spent against. Any OpenAI-compatible
# endpoint, which is what the AI settings page promises. The key itself is not
# here -- it lives encrypted in users.ai_api_key, entered through the dashboard.
GRITQA_MODEL=
GRITQA_MODEL_BASE_URL=

# Dev-only: draft without a stored key, billed to this server rather than the
# developer. Off unless set, because the AI settings page reads "Drafting off"
# from the absence of a key and treats the key as the consent -- a default that
# drafted anyway would contradict both. Ignored when NODE_ENV is production.
#
# Auth is ADC, so run `gcloud auth application-default login` once; tokens are
# minted and refreshed by google-auth-library. Vertex rather than AI Studio
# because the free Generative Language tier is 20 requests a day.
GRITQA_DEV_MODEL=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1
